{
  "format": "altaudio.keymap",
  "schema_version": 1,
  "bindings": {
    "edit.undo": ["Ctrl+Z"],
    "edit.redo": ["Ctrl+Y"],
    "file.save": ["Ctrl+S"],
    "file.open": ["Ctrl+O"],
    "file.new-session": ["Ctrl+N"],
    "edit.select-all": ["Ctrl+A"],
    "edit.cut": ["Ctrl+X"],
    "edit.copy": ["Ctrl+C"],
    "edit.paste": ["Ctrl+V"],
    "edit.delete": ["Delete", "Backspace"],
    "multitrack.play-pause": ["Space"],
    "clip.split": ["Ctrl+K"],
    "view.zoom-in": ["Ctrl+="],
    "view.zoom-out": ["Ctrl+-"],
    "edit.find": ["Ctrl+F"],
    "tool.razor": ["R"],
    "tool.move": ["V"],
    "tool.time": ["T"],
    "tool.slip": ["Y"]
  }
}
