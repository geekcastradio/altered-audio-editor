{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Altered Audio Editor",
  "version": "0.1.9",
  "identifier": "com.thegcrn.alteredaudioeditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Altered Audio Editor",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "The GeekCast Radio Network, LLC",
    "copyright": "Copyright (c) The GeekCast Radio Network, LLC. Licensed under GPL-3.0-or-later.",
    "category": "Music",
    "shortDescription": "Multitrack audio editor for podcasters and voiceover",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "licenseFile": "../LICENSE",
    "macOS": {
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true
    }
  }
}
